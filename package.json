{
  "name": "threadlatch",
  "version": "0.1.0-preview.1",
  "description": "Source-linked, portable project memory across AI conversations",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "bin": {
    "threadlatch": "dist-cli/cli/index.js"
  },
  "files": [
    "dist-cli/",
    "skills/threadlatch/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build": "npm run build:cli && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
